# =============================================
# BDSisters.org Backend — Environment Variables
# Copy this file to .env and fill in values
# =============================================

# Server
PORT=5000

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bd_sister?appName=Cluster0

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# Resend (email service — https://resend.com)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=no-reply@bdsisters.org

# Better Auth (optional — keep if using Better Auth sessions)
BETTER_AUTH_SECRET=your_better_auth_secret_here

# ZiniPay Payment Gateway (https://zinipay.com)
ZINIPAY_API_KEY=your_zinipay_api_key_here
ZINIPAY_BASE_URL=https://api.zinipay.com/v1

# URLs (no trailing slash)
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
